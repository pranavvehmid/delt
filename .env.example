# Copy this file to .env.local and fill in each value. Never commit .env.local.

# Random secret for sign-in cookies. Generate with: npx auth secret
AUTH_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email domains that can sign in (comma-separated)
ALLOWED_DOMAINS=vitstudent.ac.in,vit.ac.in

# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# Any long random string. Vercel Cron sends it to /api/sync.
CRON_SECRET=

# Free Gemini API key from aistudio.google.com (no billing). Leave empty to use free rules only.
GEMINI_API_KEY=

# Phone notifications (free, uses the browser's own push service). Generate once with:
#   npx web-push generate-vapid-keys
# Leave empty to turn notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Encrypts each student's Google refresh token at rest (#27). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional: without it, a key derived from AUTH_SECRET is used. Keep a copy somewhere safe:
# losing it means every student has to sign in again.
TOKEN_ENCRYPTION_KEY=
# Only while rotating: the previous key, so old values still open (see docs/OPERATIONS.md).
TOKEN_ENCRYPTION_KEY_OLD=
