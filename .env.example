# Copy this file to .env.local and fill in each value. Never commit .env.local.

# Random secret for sign-in cookies. Generate with: npx auth secret
AUTH_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email domains that can sign in (comma-separated)
ALLOWED_DOMAINS=vitstudent.ac.in,vit.ac.in

# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# Any long random string. Vercel Cron sends it to /api/sync.
CRON_SECRET=

# Free Gemini API key from aistudio.google.com (no billing). Leave empty to use free rules only.
GEMINI_API_KEY=
